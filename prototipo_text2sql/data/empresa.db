CREATE TABLE empleados (
    id INTEGER PRIMARY KEY,
    nombre TEXT,
    departamento TEXT,
    salario INTEGER
);

CREATE TABLE departamentos (
    id INTEGER PRIMARY KEY,
    nombre TEXT,
    ubicacion TEXT
);

